{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-skills:mechanised-expertise:inquiry-card-v1",
  "title": "Mechanised Expertise Inquiry Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "focus", "context", "cues", "questions", "model", "alternatives", "decision", "verification", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 3},
    "status": {"enum": ["investigating", "proposed", "implemented", "verified", "superseded"]},
    "focus": {"type": "string", "minLength": 8},
    "context": {"type": "object", "required": ["users", "platform", "constraints"], "properties": {
      "users": {"type": "array", "items": {"type": "string"}},
      "platform": {"type": "string"},
      "constraints": {"type": "array", "items": {"type": "string"}}
    }},
    "cues": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
    "model": {"type": "object", "required": ["competency_questions", "nodes", "edges", "gaps"], "properties": {
      "competency_questions": {"type": "array", "items": {"type": "string"}},
      "nodes": {"type": "array", "items": {"type": "string"}},
      "edges": {"type": "array", "items": {"type": "object", "required": ["from", "predicate", "to", "truth_kind"], "properties": {
        "from": {"type": "string"}, "predicate": {"type": "string"}, "to": {"type": "string"}, "truth_kind": {"enum": ["observed", "source_claim", "hypothesis"]}, "source_ids": {"type": "array", "items": {"type": "string"}}
      }}},
      "gaps": {"type": "array", "items": {"type": "object", "required": ["name", "classification", "next_probe"], "properties": {
        "name": {"type": "string"}, "classification": {"enum": ["acquisition", "alias", "schema", "missing-edge", "contradictory", "boundary", "excluded", "unknown", "frontier-candidate"]}, "next_probe": {"type": "string"}
      }}}
    }},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "description", "risk", "discriminator"], "properties": {
      "id": {"type": "string"}, "description": {"type": "string"}, "risk": {"type": "string"}, "discriminator": {"type": "string"}
    }}},
    "decision": {"type": "object", "required": ["status", "selected", "rationale", "reversal_trigger"], "properties": {
      "status": {"enum": ["deferred", "proposed", "accepted", "rejected"]}, "selected": {"type": ["string", "null"]}, "rationale": {"type": "string"}, "reversal_trigger": {"type": "string"}
    }},
    "verification": {"type": "object", "required": ["oracle", "tier", "result"], "properties": {
      "oracle": {"type": "string", "minLength": 8}, "tier": {"enum": ["not-run", "static", "simulated", "device", "field", "controlled-comparison"]}, "result": {"enum": ["not-run", "pass", "fail", "mixed"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}
    }},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "role", "url", "scope"], "properties": {
      "id": {"type": "string"}, "role": {"enum": ["recommendation", "constraint", "test", "counterexample", "editorial"]}, "url": {"type": "string"}, "scope": {"type": "string"}
    }}}
  },
  "$defs": {
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "text", "why", "answer_source", "status", "decision_impact"], "properties": {
      "id": {"type": "string"}, "text": {"type": "string", "minLength": 8}, "why": {"type": "string"}, "answer_source": {"enum": ["code", "documentation", "user-research", "experiment", "owner"]}, "status": {"enum": ["open", "answered", "not-applicable"]}, "decision_impact": {"type": "string"}, "answer": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}
    }}
  }
}